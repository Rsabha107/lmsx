APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_INACTIVITY_TIMEOUT=30
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production hardening - set these on the live server, then run `php artisan app:check-production`.
# APP_ENV=production
# APP_URL=https://your-host
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# Comma-separated CIDRs of the load balancer. Unset = loopback/private ranges only; never '*' if the origin is reachable.
# TRUSTED_PROXIES=
# Comma-separated hostnames the app answers to (a wrong value 403s every request).
# TRUSTED_HOSTS=
# Mobile API token lifetime in minutes (default 20160 = 14 days).
# SANCTUM_TOKEN_EXPIRATION=20160

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

AVIATIONSTACK_API_KEY=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/microsoft/callback"

ANTHROPIC_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=
AI_TIMEOUT=15

# Only needed if a feature starts using these capabilities - Anthropic provides none
# of them. Set the provider and its API key together (see config/ai.php).
# AI_PROVIDER_IMAGES=gemini
# AI_PROVIDER_AUDIO=openai
# AI_PROVIDER_TRANSCRIPTION=openai
# AI_PROVIDER_EMBEDDINGS=openai
# AI_PROVIDER_RERANKING=cohere
